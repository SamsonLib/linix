;; app init entry + launcher
(define (jolt-app-init!)
  (jolt-startup-profile-mark! "app namespaces begin")
  (jolt-app-init$builder$0!)
  (jolt-app-init$builder$1!)
  (jolt-app-init$errors$0!)
  (jolt-app-init$reader$0!)
  (jolt-app-init$reader$1!)
  (jolt-app-init$reader$2!)
  (jolt-app-init$modules$0!)
  (jolt-app-init$params$0!)
  (jolt-app-init$user-function$0!)
  (jolt-app-init$interpreter$0!)
  (jolt-app-init$interpreter$1!)
  (jolt-app-init$interpreter$2!)
  (jolt-app-init$core$0!)
  (jolt-app-init$core$1!)
  (jolt-app-init$core$2!)
  (jolt-app-init$core$3!)
  (jolt-app-init$core$4!)
  (jolt-app-init$core$5!)
)

;; === launcher ===
(suppress-greeting #t)
(sa-gc-trip-bytes!
  (let ((trip (getenv "JOLT_GC_TRIP_BYTES"))
        (default (* 16 1024 1024)))
    (if trip (or (string->number trip) default) default)))
(jolt-install-heap-ceiling!)
(scheme-start
  (lambda args
(jolt-startup-profile-mark! "scheme-start begin")
    (jolt-install-exit-handler!)
    (jolt-arm-shutdown!)
    (guard (v (#t (jolt-report-throwable v (current-error-port)) (exit 1)))
      (jolt-app-init!)
      (let ((base (or (getenv "JOLT_PWD") ".")))
        (set-source-roots!*
          (append (map (lambda (r) (string-append base "/" r)) (list "src" ))
                  (list "jolt-core" "stdlib" "vendor/fs/src" "vendor/process/src" "vendor/cli/src" "vendor/grenadine/src" "vendor/grenadine-generated"))))
(jolt-startup-profile-mark! "scheme-start setup")
      (let ((maincell (var-cell-lookup "core" "-main")))
        (set-chez-ns! "user")
        (when (and maincell (var-cell-defined? maincell))
          (with-exception-handler
            (lambda (c) (when (serious-condition? c) (jolt-capture-fault! c)) (raise-continuable c))
            (lambda ()
              (jolt-with-ns-load-vars
                (lambda ()
                  (let ((jolt-main-result (apply jolt-invoke (var-cell-root maincell) args)))
                    (jolt-startup-profile-mark! "entry -main")
                    jolt-main-result))))))))
    (jolt-await-user-threads!)
    (exit 0)))
