|     UNEXPECTED (5);
|   /* Step 6: Release the baton.  */
|   if (pthread_mutex_unlock (&baton))
|     UNEXPECTED (6);
|   /* Step 7: The writer thread requests the lock.  */
|   if (pthread_rwlock_wrlock (&lock))
|     UNEXPECTED (7);
|   return NULL;
| }
